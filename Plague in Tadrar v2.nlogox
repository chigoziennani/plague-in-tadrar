  <previewCommands>preset-silent-spreader repeat 40 [ go ]</previewCommands>
  <experiments>
    <experiment name="lethality-sweep" repetitions="15" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>deaths</metric>
        <metric>percent-infected</metric>
        <metric>lowest-canal</metric>
        <metric>hungry-houses</metric>
        <metric>most-hungry</metric>
        <metric>grain-gap</metric>
        <metric>grain-cv</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="infectivity">
          <value value="15"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="khams-interval">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="withdrawal">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="migration">
          <value value="15"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mutation-day">
          <value value="0"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="lethality" first="0" step="10" last="100"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="withdrawal-sweep" repetitions="15" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>preset-plague-inc</setup>
      <go>go</go>
      <metrics>
        <metric>deaths</metric>
        <metric>percent-infected</metric>
        <metric>lowest-canal</metric>
        <metric>hungry-houses</metric>
        <metric>most-hungry</metric>
        <metric>grain-gap</metric>
        <metric>grain-cv</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="khams-interval">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="migration">
          <value value="15"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="withdrawal" first="0" step="25" last="100"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="lethality-sweep-emergence" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>deaths</metric>
        <metric>percent-infected</metric>
        <metric>lowest-canal</metric>
        <metric>hungry-houses</metric>
        <metric>most-hungry</metric>
        <metric>grain-gap</metric>
        <metric>grain-cv</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="infectivity">
          <value value="15"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="khams-interval">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="withdrawal">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="migration">
          <value value="15"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mutation-day">
          <value value="0"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="lethality" first="0" step="10" last="100"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="khams-interval-sweep" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>preset-silent-spreader</setup>
      <go>go</go>
      <metrics>
        <metric>deaths</metric>
        <metric>percent-infected</metric>
        <metric>lowest-canal</metric>
        <metric>hungry-houses</metric>
        <metric>most-hungry</metric>
        <metric>grain-gap</metric>
        <metric>grain-cv</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="num-households">
          <value value="28"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="withdrawal">
          <value value="50"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="migration">
          <value value="15"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-infected">
          <value value="1"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="khams-interval" first="1" step="1" last="7"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
