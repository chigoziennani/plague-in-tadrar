<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; PLAGUE IN TADRAR v2: 1 tick = 1 day, runs for 1 year

globals [
  deaths ; how many people the plague killed
  total-cases ; how many people ever got infected
  start-pop ; how many villagers there were at the start
  canal ; canal condition, 0-100
  lowest-canal ; worst the canal got all run
  cure ; cure bar, 0-100 (like plague inc)
  alarm? ; has the village noticed the plague yet?
  lethality-now ; lethality right now (goes up if it mutates)
  helpers-today ; how many houses sent someone to khams today
  most-hungry ; most houses out of grain at once
  
  ; these used to be sliders - now set by the presets or defaults in setup
  stealth ; days infected but still working & spreading
  sick-days ; days stuck at home sick
  mutated-lethality ; lethality after the pathogen mutates
  alarm-threshold ; deaths needed before the village panics
  cure-rate ; how fast the cure bar fills
]

breed [ households household ]
breed [ villagers villager ]

households-own [
  my-field ; the patch this family farms
  grain ; how much food the family has stored
  scared? ; true = won't send anyone to khams
  land ; property owned - unequal, like real Tadrar (drives how much grain it grows)
]

villagers-own [
  my-hh ; which household they belong to
  worker? ; true if they go out to work
  away? ; left for wage labor in the city (Crawford & West's migration)
  infected? ; has the disease (hidden or sick)
  sick? ; showing symptoms -> stays home
  immune? ; got better & can't catch it again
  sick-time ; days since they got infected
]

patches-own [
  zone ; "mountain" "slope" "field" "river" "canal" "dry" or "khams"
  shade ; little random bit so the colors aren't flat
]

to setup
  clear-all
  set stealth 4
  set sick-days 7
  set mutated-lethality 70
  set alarm-threshold 3
  set cure-rate 1
  set canal 100
  set lowest-canal 100
  set cure 0
  set alarm? false
  set lethality-now lethality
  make-valley
  make-households
  make-villagers
  send-migrants
  set start-pop count villagers with [ not away? ]
  ask n-of initial-infected villagers with [ not away? ] [ get-infected ]
  update-colors
  reset-ticks
end

; draws the valley: mountains on the edges, dry slopes, fields in the middle w/ a river
to make-valley
  ask patches [
    set shade random-float 2
    ifelse pxcor < 2 + random 2 or pxcor > 61 - random 2 [ set zone "mountain" ]
    [ ifelse pxcor < 13 + random 3 or pxcor > 50 - random 3 [ set zone "slope" ]
      [ set zone "field" ] ]
  ]
  ask patches with [ abs (pxcor - (29 + pycor / 8)) < 1.5 ] [ set zone "river" ]
  ask patches with [ zone = "field" and pycor = 37 ] [ set zone "canal" ]
  ask patches with [ zone = "field" and pycor > 37 ] [ set zone "dry" ]
  ask patch 40 40 [ ask patches in-radius 2.5 with [ zone = "dry" ] [ set zone "khams" ] ]
  ask patches [
    if zone = "mountain" [ set pcolor 31 + shade ]
    if zone = "slope" [ set pcolor 35 + shade ]
    if zone = "river" [ set pcolor 94 + shade / 2 ]
    if zone = "canal" [ set pcolor 96 ]
    if zone = "dry" [ set pcolor 37 + shade / 2 ]
    if zone = "khams" [ set pcolor 116 ]
  ]
end

; Crawford counted 28 households in Tadrar. each gets a field, a grain store & an unequal amount of land (most have a little, a few have a lot)
to make-households
  create-households num-households [
    move-to one-of patches with [ zone = "slope" and not any? households in-radius 2 ]
    set shape "house"
    set color white
    set size 1.6
    set land 1 + min (list 6 (random-exponential 1.8))
    set my-field one-of patches with [ zone = "field" ]
    set grain 50
    set scared? false
  ]
end

; each house gets 3-9 people, about 60% of them are workers
to make-villagers
  ask households [
    hatch-villagers 3 + random 7 [
      set my-hh myself
      set shape "person"
      set size 0.9
      set worker? random 100 < 60
      set away? false
      set infected? false
      set sick? false
      set immune? false
    ]
  ]
end

; Crawford & West: men leave for wage labor. migration % of workers go away - they don't farm, do khams, or catch the plague but their labor is gone
to send-migrants
  ask villagers with [ worker? ] [
    if random 100 < migration [ set away? true hide-turtle ]
  ]
end

; plague inc style presets for the demo
to preset-burnout
  setup
  set infectivity 20
  set lethality 80
  set lethality-now 80
  set stealth 3
  set sick-days 5
  set mutation-day 0
end

to preset-silent-spreader
  setup
  set infectivity 15
  set lethality 5
  set lethality-now 5
  set stealth 8
  set sick-days 7
  set mutation-day 0
end

; the plague inc strategy: spread quietly first, then turn deadly
to preset-plague-inc
  setup
  set infectivity 15
  set lethality 5
  set lethality-now 5
  set stealth 8
  set sick-days 7
  set mutation-day 20
  set mutated-lethality 70
end

to go
  if ticks = 365 [ stop ]
  if mutation-day > 0 and ticks = mutation-day [ set lethality-now mutated-lethality ]
  go-to-work
  spread
  display
  farm
  go-home
  spread
  eat
  get-sicker
  fix-canal
  check-alarm
  work-on-cure
  update-colors
  tick
end

; workers go to their field, sick people & kids stay home. every few days each house sends 1 worker to khams (unless they're scared)
to go-to-work
  ask villagers with [ worker? and not sick? and not away? ] [
    move-to [ my-field ] of my-hh
    wiggle
  ]
  set helpers-today 0
  if ticks mod khams-interval = 0 [
    ask households with [ not scared? ] [
      let me self
      let helpers villagers with [ my-hh = me and worker? and not sick? and not away? ]
      if any? helpers [
        ask one-of helpers [ move-to one-of patches with [ zone = "khams" ] wiggle ]
        set helpers-today helpers-today + 1
      ]
    ]
  ]
end

to go-home
  ask villagers with [ not away? ] [ move-to my-hh wiggle ]
end

to wiggle
  rt random 360
  fd random-float 0.5
end

; anyone infected can give it to healthy people right next to them (stops once cured)
to spread
  if cure < 100 [
    ask villagers with [ infected? and not away? ] [
      ask other villagers in-radius 1.2 with [ not infected? and not immune? and not away? ] [
        if random 100 < infectivity [ get-infected ]
      ]
    ]
  ]
end

to get-infected
  set infected? true
  set sick-time 0
  set total-cases total-cases + 1
end

; hidden for "stealth" days, then sick for "sick-days", then die or get better. a hungry house is weaker, so its sick are 1.5x more likely to die
to get-sicker
  ask villagers with [ infected? ] [
    set sick-time sick-time + 1
    if sick-time > stealth [ set sick? true ]
    if sick-time > stealth + sick-days [
      let chance lethality-now
      if [ grain ] of my-hh = 0 [ set chance chance * 1.5 ]
      ifelse random 100 < chance [
        set deaths deaths + 1
        die
      ] [
        set infected? false set sick? false set immune? true
      ]
    ]
  ]
end

; workers in the field bring in grain - more land means more, less if the canal is bad. 1% spoils each day so rich houses settle higher than poor ones instead of growing forever
to farm
  ask households [
    let me self
    let farmers count villagers with [ my-hh = me and not away? and patch-here = [ my-field ] of me ]
    set grain grain + farmers * (land + 2) * 0.6 * canal / 100
    set grain grain * 0.99
  ]
end

; everybody home eats 1 grain a day. a house w/ 0 grain is hungry. empty houses are gone
to eat
  ask households [
    let me self
    let family count villagers with [ my-hh = me and not away? ]
    set grain grain - family
    if grain < 0 [ set grain 0 ]
    if family = 0 [ die ]
  ]
  if hungry-houses > most-hungry [ set most-hungry hungry-houses ]
end

; the canal silts up 2/day. khams days repair it depending on who showed up
to fix-canal
  set canal canal - 2
  if ticks mod khams-interval = 0 and any? households [
    set canal canal + 2.4 * khams-interval * helpers-today / count households
  ]
  if canal > 100 [ set canal 100 ]
  if canal < 0 [ set canal 0 ]
  if canal < lowest-canal [ set lowest-canal canal ]
end

; once enough die the village panics & scared houses skip khams; they rejoin when it's over
to check-alarm
  if not alarm? and deaths >= alarm-threshold [
    set alarm? true
    ask households [ if random 100 < withdrawal [ set scared? true ] ]
  ]
  if alarm? and not any? villagers with [ infected? ] [
    ask households [ set scared? false ]
  ]
end

; the cure bar fills once the village is alarmed; at 100 everyone left is cured
to work-on-cure
  if alarm? and cure < 100 [
    set cure cure + cure-rate
    if cure >= 100 [
      set cure 100
      ask villagers [ set infected? false set sick? false set immune? true ]
    ]
  ]
end

; white healthy, red hidden, orange sick, gray immune. fields brown when the canal is bad, ouses yellow when out of grain, & sized by how much land they own (so you see inequality)
to update-colors
  ask villagers [
    ifelse sick? [ set color orange ]
    [ ifelse infected? [ set color red ]
      [ ifelse immune? [ set color gray ] [ set color white ] ] ]
  ]
  ask patches with [ zone = "field" ] [
    ifelse canal < 50 [ set pcolor 36 + shade ] [ set pcolor 54 + shade ]
  ]
  ask households [
    ifelse grain = 0 [ set color yellow ] [ set color white ]
    set size 1.1 + land / 5
  ]
end

to-report percent-infected
  report 100 * total-cases / start-pop
end

to-report hungry-houses
  report count households with [ grain = 0 ]
end

; how spread out grain is across the houses (bigger = more unequal). watching it over the year is a simple read on Crawford's "temporal" inequality
to-report grain-gap
  if not any? households [ report 0 ]
  report standard-deviation [ grain ] of households
end

; the grain gap divided by the average - a scale-free read on inequality (the coefficient of variation). the plague shrinks the raw gap only by shrinking everyone's grain,
; so this relative measure is the honest one: it does NOT fall when the plague hits, which is why the raw gap alone is misleading
to-report grain-cv
  if not any? households [ report 0 ]
  if mean [ grain ] of households = 0 [ report 0 ]
  report (standard-deviation [ grain ] of households) / (mean [ grain ] of households)
end

to-report migrants-away
  report count villagers with [ away? ]
end]]></code>
