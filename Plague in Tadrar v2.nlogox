      <update></update>
      <pen interval="1.0" mode="0" display="healthy" color="-10899396" legend="true">
        <setup></setup>
        <update>plot count villagers with [ not infected? and not immune? ]</update>
      </pen>
      <pen interval="1.0" mode="0" display="hidden" color="-2674135" legend="true">
        <setup></setup>
        <update>plot count villagers with [ infected? and not sick? ]</update>
